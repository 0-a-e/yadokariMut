# =============================================================================
# YadokariMut 環境変数テンプレート
# 使い方: cp .env.example .env  のあと、必要なキーだけ埋める
# =============================================================================

# --- LLM (DeepSeek) ----------------------------------------------------------
# 画面内 AI アシスタントで使用
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- 意味検索 embedding (optional) --------------------------------------------
# Gemini embedding による物件の意味検索 (pgvector) で使用。
# 未設定でも意味検索以外は動作する (ベクトルのバックフィルは `backfill-embeddings` CLI)
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Geocoding (optional) ----------------------------------------------------
# provider に Google を指定したときのみ必須。未設定時は Nominatim 経路のみで動作
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- 物件ドメイン PostgreSQL --------------------------------------------------
# docker-compose.yml の db サービスと対応。ローカル利用なら既定値のままで可。
# 初回は `docker compose run --rm yadokari-mut db-init` でスキーマを適用する
# YADOKARIMUT_PG_USER=yadokari
# YADOKARIMUT_PG_PASSWORD=yadokari-mut
# YADOKARIMUT_PG_DB=property
# YADOKARIMUT_PG_PORT=5433
# PGDATA の配置先 (任意のディレクトリへ外出し可)
# YADOKARIMUT_PGDATA_DIR=./data/postgres-property

# --- メディアストレージ rustfs ------------------------------------------------
# docker-compose.yml の rustfs サービスへ渡す認証情報。値は任意の文字列でよいが
# 推測困難なものにする (例: openssl rand -hex 16 の出力)。
# compose 起動に必須。app 側は未設定でもメディア機能が無効になるだけで起動する
YADOKARIMUT_RUSTFS_ACCESS_KEY=change_me
YADOKARIMUT_RUSTFS_SECRET_KEY=change_me
# YADOKARIMUT_RUSTFS_BUCKET=yadokari-media
# YADOKARIMUT_RUSTFS_REGION=us-east-1
# YADOKARIMUT_RUSTFS_DATA_DIR=./data/rustfs

# --- Scheduler (Docker Compose では environment でも指定) ---------------------
# ENABLE_SCHEDULER=true
# 収集設定 (県ローテーション・日次上限・cron 等) は管理画面 (設定ボード) から
# app_settings (DB) に保存して変更します。環境変数では管理しません

# --- Vector tiles (PMTiles → ZXY 配信 /api/tiles/{code}/{z}/{x}/{y}.pbf) -----
# scripts/ksj/ で生成した {code}.pmtiles の置き場所。未設定時は data/tiles
# TILES_DIR=data/tiles

# --- Scrape HTTP / proxy (default off = 直接取得のみ) ------------------------
# off | fallback | always_proxy
SCRAPE_HTTP_MODE=off
# SCRAPE_HTTP_PROXY=http://user:pass@host:port
SCRAPE_HTTP_MAX_RETRIES=2
SCRAPE_HTTP_TIMEOUT_SECONDS=45
